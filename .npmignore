# Build inputs — not needed by consumers
src/
src-ts/*.ts
build.rs
Cargo.toml
Cargo.lock
rust-toolchain.toml
tsconfig.json

# Compiled Rust output — too large, native binaries go into platform packages
target/

# Dev dependencies and lock files
node_modules/

# Examples — useful on GitHub, not in the npm package
examples/

# napi-rs publish staging directories (auto-generated)
artifacts/
npm/

# Other markdown (README.md is published via `files` allowlist)
*.md
!README.md

# OS / editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# CI
.github/

# Env / logs
.env
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
